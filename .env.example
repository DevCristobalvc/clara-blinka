# ORBIT environment. Copy to .env.local for development; set the same names in Vercel for production.
# Everything is optional: without a variable the app falls back to a labeled demo mode (see each comment).
# Never commit .env.local. Only NEXT_PUBLIC_* values reach the browser.

# --- Models ---------------------------------------------------------------
# Reads uploaded invoices (PDF, image, email, chat) and writes the negotiation messages.
# Without it: uploads return 503, messages use templates, the demo set still works (pre-extracted).
ANTHROPIC_API_KEY=

# JEV (TypeSafe): fast typed judgments (concept vs contract, pressure, risk).
# Without it: a local heuristic, labeled "offline" in every decision.
TYPESAFE_API_KEY=

# --- Storage --------------------------------------------------------------
# Supabase project for cases, policies and the audit trail (schema in db/schema.sql).
# Without both: an in-memory store (cases vanish on restart; fine for local dev, useless on Vercel).
SUPABASE_URL=https://nzqukgthqjcelyematst.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC_

# --- Trust ----------------------------------------------------------------
# Ed25519 key that signs every decision receipt, and the secret the agent wallets derive from.
# Generate once: node scripts/gen-signing-key.mjs. Without it: a random per-process key (receipts say
# "ephemeral", agent wallet addresses change on restart). CLARA_SIGNING_KEY is still accepted.
ORBIT_SIGNING_KEY=
# Optional: a separate secret for deriving agent wallets (defaults to ORBIT_SIGNING_KEY).
ORBIT_WALLET_SEED=
# Optional: if set, PUT /api/policy (changing the rules) requires the header X-Orbit-Admin: <token>.
ORBIT_ADMIN_TOKEN=

# --- Hiring the agents: Privy login + x402 payments in USDC on Base Sepolia -----------
# Privy app (dashboard.privy.io). Gives the company a login and an embedded wallet that pays ORBIT.
# Add localhost:3000, orbit.devcristobalvc.com and *.vercel.app to the app's allowed domains.
# Without it: only the demo login (123 / 123), no wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_SECRET=                          # not used by the app today (server-side token checks are a later step)

# Where activation fees land: ORBIT's treasury address on Base Sepolia (0x...).
ORBIT_PAY_TO=
# Private key of that treasury, only so the team can sweep testnet USDC. The app never reads it.
ORBIT_TREASURY_PRIVATE_KEY=
# A funded test wallet for scripts/x402-pay.mjs (faucet: https://faucet.circle.com, Base Sepolia).
ORBIT_TEST_PAYER_PRIVATE_KEY=

# Switches
ORBIT_ACTIVATION_FREE=                 # 1 = activate / fund agents without paying (previews, no wallet)
ORBIT_REQUIRE_ACTIVATION=              # 1 = refuse to open cases until the pagador is active
X402_FACILITATOR_URL=                  # default https://x402.org/facilitator
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=      # optional RPC for USDC balance reads (default public RPC)

# --- Dev ------------------------------------------------------------------
ORBIT_PROSE=                           # template = force template wording even with an Anthropic key
ORBIT_EVAL_LIVE=                       # 1 = run the dataset eval against live JEV
